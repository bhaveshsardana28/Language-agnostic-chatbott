# Global Multilingual AI Assistant (v2 layer) — copy to .env and fill.
# The V2 workspace and legacy chat form use the same provider settings.

# --- LLM provider (general chat route) ---
# Supported providers: groq | openrouter | openai | ollama
# groq/openrouter/openai share the OpenAI-compatible API shape.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=
# Ollama (optional local): LLM_PROVIDER=ollama LLM_MODEL=qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434

# Endpoints (defaults are sensible; override only if needed)
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1   (set LLM_PROVIDER=openrouter too)

# --- Limits ---
MAX_MESSAGE_CHARS=4000
MEMORY_TURNS=10

# --- document ingestion and local OCR ---
MAX_UPLOAD_BYTES=10485760
MAX_DOCUMENT_PAGES=100
GAIA_DB_PATH=data/gaia.db
DOCUMENT_STORAGE_DIR=data/uploads
OCR_ENABLED=1
# Tesseract language codes. Use an installed combination such as eng+hin.
OCR_LANG=eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=30
OCR_MIN_TEXT_CHARS=24
OCR_REVIEW_CONFIDENCE=60
MAX_IMAGE_PIXELS=40000000
MAX_ARCHIVE_ENTRIES=100
MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
MAX_RENDER_PIXELS=20000000
WORKSPACE_COOKIE_SECURE=0
# OCR_CONFIG examples: --psm 6 (blocks), --psm 3 (automatic page layout)
OCR_CONFIG=--psm 6

# Maximum generated tokens per provider request. Match LLM_MODEL to the provider.
LLM_MAX_OUTPUT_TOKENS=1024
