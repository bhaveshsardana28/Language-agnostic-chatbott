# ---------------------------------------------------------------------------
# Aikya — environment variables (copy to .env and fill what you need).
# All keys are OPTIONAL: the app works out-of-the-box with Ollama (no key).
# ---------------------------------------------------------------------------

# Local Ollama (default backend, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Cloud providers — set the ones you want to use from the sidebar picker.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
PERPLEXITY_API_KEY=
